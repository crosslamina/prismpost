# 個人向けGmailアドレス（返信元、転送先）
ALLOWED_GMAIL_ADDRESS=your-personal-account@gmail.com

# AES-256-GCM暗号化キー (32バイト以上のランダム文字列、または64文字のHEX)
SECRET_KEY=generate_random_32_bytes_key_here_prismpost_secret

# Resend APIキー (https://resend.com で取得)
RESEND_API_KEY=re_xxxxxxxxxxxx

# （任意）デフォルトの送信者表示名
DEFAULT_SENDER_NAME=PrismPost

# （任意）トークンの有効期限（日数、デフォルト: 30）
TOKEN_EXPIRATION_DAYS=30
